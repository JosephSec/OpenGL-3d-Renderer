{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Build",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/build/program.exe",
      "externalConsole": true,
      "preLaunchTask": "CompileExe",
    },
    {
      "name": "Release",
      "type": "cppdbg",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "program": "${workspaceFolder}/release/assets/program.exe",
      "externalConsole": true,
      "preLaunchTask": "Release",
    }
  ]
}