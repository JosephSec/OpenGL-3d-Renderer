{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile Exe",
      "type": "shell",
      "command": "g++",
      "args": [        
        "-I${workspaceFolder}/include",
        "${workspaceFolder}/src/*.cpp",
        
        "-O3", "-flto",
        "-o", "${workspaceFolder}/build/program.exe",
        
        "${workspaceFolder}/src/Engine/*.cpp",
        "${workspaceFolder}/src/Engine/Renderer/*.cpp",
        // "${workspaceFolder}/bin/zengine.dll",
        
        "-lsfml-graphics", "-lsfml-window", "-lsfml-system",
        "-lglew32", "-lopengl32",
      ]
    },
    {
      "label": "Compile DLL",
      "type": "shell",
      "command": "g++",
      "args": [
        "-O3", "-flto",

        "-I${workspaceFolder}/include",

        "-shared",
        "-o",

        "${workspaceFolder}/bin/zengine.dll",

        "${workspaceFolder}/src/Engine/*.cpp",
        "${workspaceFolder}/src/Engine/Renderer/*.cpp",

        "-lsfml-graphics", "-lsfml-window", "-lsfml-system", "-lglew32", "-lopengl32"
      ],
    },
    {
      "label": "Publish Engine Files",
      "type": "shell",
      "command": "${workspaceFolder}/assets/UpdateGlobalFiles.bat",
      "args": [
        "ZEngine", "Engine"
      ],
      "dependsOn": ["Compile DLL"]
    },
    {
      "label": "Import Tool",
      "type": "shell",
      "command": "C:/Users/${env:USERNAME}/OneDrive/Desktop/VsCode/cpp/my/tools/ImportTool.bat ${workspaceFolder}"
    },
    {
      "label": "Create Object Files",
      "type": "shell",
      "command": "C:/Users/${env:USERNAME}/OneDrive/Desktop/VsCode/cpp/my/tools/CreateObjectFiles.bat"
    },
    {
      "label": "Create Static Object Files",
      "type": "shell",
      "command": "C:/Users/${env:USERNAME}/OneDrive/Desktop/VsCode/cpp/my/tools/CreateStaticObjectFiles.bat"
    }
  ]
}